<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Air Force 1 – 3D Header</title>
<style>
:root{--bg:#f3f1ec;--fg:#111;--muted:#5d5b56;--accent:#e8e8e6;--card:#fff;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#101113;--fg:#f4f4f2;--muted:#a3a29d;--card:#1b1c1f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#101113;--fg:#f4f4f2;--muted:#a3a29d;--card:#1b1c1f;color-scheme:dark}
*{box-sizing:border-box;margin:0}
html,body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header.hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;display:flex;flex-direction:column}
nav{display:flex;justify-content:space-between;align-items:center;padding:22px clamp(20px,5vw,64px);position:relative;z-index:3}
nav b{letter-spacing:.2em;font-size:.8rem}
nav ul{display:flex;gap:28px;list-style:none;padding:0;font-size:.85rem;color:var(--muted)}
.wrap{flex:1;display:grid;grid-template-columns:1fr 1.25fr;align-items:center;gap:8px;padding:0 clamp(20px,5vw,64px) 40px;position:relative}
.ghost{position:absolute;right:2%;top:50%;transform:translateY(-52%);font:900 clamp(10rem,32vw,30rem)/1 "Arial Black",Impact,sans-serif;color:var(--fg);opacity:.05;pointer-events:none;user-select:none}
.copy{position:relative;z-index:2}
.tag{font-size:.75rem;letter-spacing:.3em;color:var(--muted);margin-bottom:14px}
h1{font:900 clamp(2.6rem,7vw,6rem)/.92 "Arial Black",Impact,sans-serif;text-transform:uppercase;letter-spacing:-.02em}
h1 span{color:var(--accent);-webkit-text-stroke:2px var(--fg)}
p.lead{margin:20px 0 28px;color:var(--muted);max-width:34ch;line-height:1.55}
.cta{display:inline-block;background:var(--fg);color:var(--bg);padding:15px 30px;border-radius:99px;font-weight:700;text-decoration:none;font-size:.9rem}
.sw{display:flex;gap:12px;margin-top:34px;align-items:center;font-size:.8rem;color:var(--muted)}
.sw button{width:30px;height:30px;border-radius:50%;border:2px solid var(--bg);outline:2px solid transparent;cursor:pointer;transition:transform .2s}
.sw button:hover{transform:scale(1.12)}
.sw button.on{outline-color:var(--fg)}
.stageBox{position:relative;height:min(72vh,640px);min-height:340px}
.blob{position:absolute;inset:8% 4%;border-radius:50%;background:radial-gradient(circle,var(--accent) 0%,transparent 68%);opacity:.55;transition:background .5s}
#stage{position:absolute;inset:0;cursor:grab;touch-action:pan-y}
#stage:active{cursor:grabbing}
#stage canvas{display:block;width:100%;height:100%}
.hint{position:absolute;bottom:0;left:50%;transform:translateX(-50%);font-size:.72rem;color:var(--muted);letter-spacing:.15em}
.fallback{padding:40px;color:var(--muted)}
@media(max-width:820px){.wrap{grid-template-columns:1fr;text-align:center}.copy{order:2}p.lead{margin-inline:auto}.sw{justify-content:center}nav ul{display:none}.stageBox{height:46vh}}
</style>
</head>
<body>
<header class="hero">
  <nav><b>AIR FORCE 1</b><ul><li>Men</li><li>Women</li><li>Kids</li><li>Customize</li></ul></nav>
  <div class="wrap">
    <div class="ghost">AF1</div>
    <div class="copy">
      <div class="tag">ICONIC SINCE 1982</div>
      <h1>Born in <span>the&nbsp;court.</span> Built for the street.</h1>
      <p class="lead">The legend, rebuilt in 3D. Drag the shoe to spin it and pick a colorway.</p>
      <a class="cta" href="#">Shop Air Force 1</a>
      <div class="sw" id="sw"><span>Colorway</span></div>
    </div>
    <div class="stageBox"><div class="blob" id="blob"></div><div id="stage"></div><div class="hint">DRAG TO ROTATE</div></div>
  </div>
</header>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
const el=document.getElementById('stage');
let renderer;
try{renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});}
catch(e){el.innerHTML='<p class="fallback">3D isn’t supported on this device.</p>';return;}
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.outputEncoding=THREE.sRGBEncoding;
el.appendChild(renderer.domElement);

const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(30,1,0.1,50);
camera.position.set(0,1.8,8.8);camera.lookAt(0,0.5,0);
scene.add(new THREE.HemisphereLight(0xffffff,0x8a94a3,0.95));
const key=new THREE.DirectionalLight(0xffffff,1.1);key.position.set(3,6,5);scene.add(key);
const rim=new THREE.DirectionalLight(0x9db8ff,0.9);rim.position.set(-5,2,-4);scene.add(rim);

const sm=(a,b,x)=>{const t=Math.min(1,Math.max(0,(x-a)/(b-a)));return t*t*(3-2*t)};
const hAt=u=>0.55+0.75*(1-sm(0.1,0.7,u));
const wAt=u=>0.45*(0.8+0.2*u);
const rAt=u=>Math.sqrt(Math.max(0,1-Math.pow(Math.abs(2*u-1),6)));
const topY=u=>0.3+hAt(u)*rAt(u);
const X=u=>-1.5+3*u;

const mat={
  upper:new THREE.MeshStandardMaterial({color:0xf2f2f0,roughness:.5,metalness:.04,side:THREE.DoubleSide}),
  mid:new THREE.MeshStandardMaterial({color:0xffffff,roughness:.6}),
  out:new THREE.MeshStandardMaterial({color:0xe8e8e6,roughness:.85}),
  sw:new THREE.MeshStandardMaterial({color:0xf2f2f0,roughness:.45,side:THREE.DoubleSide}),
  dark:new THREE.MeshStandardMaterial({color:0x151515,roughness:.9,side:THREE.DoubleSide}),
  lace:new THREE.MeshStandardMaterial({color:0xfafafa,roughness:.8})
};

const shoe=new THREE.Group();

// Upper (parametric skin)
const g=new THREE.PlaneGeometry(1,1,80,28),p=g.attributes.position;
for(let i=0;i<p.count;i++){
  const u=p.getX(i)+.5,v=(p.getY(i)+.5)*Math.PI,r=rAt(u);
  p.setXYZ(i,X(u),Math.pow(Math.sin(v),0.4)*hAt(u)*r,Math.cos(v)*wAt(u)*r);
}
g.computeVertexNormals();
const upper=new THREE.Mesh(g,mat.upper);upper.position.y=0.3;shoe.add(upper);

// Sole
const sh=new THREE.Shape();
for(let i=0;i<=64;i++){
  const t=i/64*Math.PI*2,c=Math.cos(t),s=Math.sin(t);
  const x=1.55*Math.sign(c)*Math.pow(Math.abs(c),0.7);
  const z=0.5*(0.8+0.2*c)*Math.sign(s)*Math.pow(Math.abs(s),0.75);
  i?sh.lineTo(x,z):sh.moveTo(x,z);
}
const mg=new THREE.ExtrudeGeometry(sh,{depth:0.26,bevelEnabled:true,bevelSize:0.04,bevelThickness:0.04,bevelSegments:3,curveSegments:1});
mg.rotateX(-Math.PI/2);
shoe.add(new THREE.Mesh(mg,mat.mid));
const og=new THREE.ExtrudeGeometry(sh,{depth:0.1,bevelEnabled:false,curveSegments:1});
og.rotateX(-Math.PI/2);og.scale(0.98,1,0.95);og.translate(0,-0.14,0);
shoe.add(new THREE.Mesh(og,mat.out));

// Collar
const col=new THREE.Group();
const u0=0.17;
col.position.set(X(u0),topY(u0)-0.04,0);col.rotation.z=-0.3;
const tor=new THREE.Mesh(new THREE.TorusGeometry(0.3,0.12,14,40),mat.upper);
tor.rotation.x=Math.PI/2;tor.scale.set(1,1.15,1);col.add(tor);
const hole=new THREE.Mesh(new THREE.CircleGeometry(0.3,32),mat.dark);
hole.rotation.x=-Math.PI/2;hole.position.y=-0.02;hole.scale.set(1,1.15,1);col.add(hole);
shoe.add(col);

// Laces
for(let i=0;i<5;i++){
  const u=0.36+i*0.075;
  const c=new THREE.Mesh(new THREE.CylinderGeometry(0.028,0.028,0.62,8),mat.lace);
  c.rotation.x=Math.PI/2;c.position.set(X(u),topY(u)+0.02,0);shoe.add(c);
}

// Toe perforations
for(let i=0;i<7;i++){
  const u=0.82+(i%3)*0.045,a=(i-3)*0.1;
  const d=new THREE.Mesh(new THREE.SphereGeometry(0.022,8,8),mat.dark);
  d.position.set(X(u),topY(u)-0.02+Math.abs(a)*-0.15,a*0.8);shoe.add(d);
}

// Swoosh
const sw=new THREE.Shape();
sw.moveTo(-0.75,0.2);
sw.bezierCurveTo(-0.5,-0.05,-0.15,-0.3,0.15,-0.22);
sw.bezierCurveTo(0.45,-0.12,0.75,0.1,1.0,0.3);
sw.bezierCurveTo(0.7,0.17,0.35,0.05,0.1,0.02);
sw.bezierCurveTo(-0.15,0.0,-0.4,0.2,-0.75,0.2);
const swg=new THREE.ExtrudeGeometry(sw,{depth:0.04,bevelEnabled:false});
swg.scale(0.65,0.65,1);swg.translate(-0.08,0.88,0.34);
const s1=new THREE.Mesh(swg,mat.sw);shoe.add(s1);
const s2=new THREE.Mesh(swg,mat.sw);s2.scale.z=-1;shoe.add(s2);

// Heel tab
const tab=new THREE.Mesh(new THREE.BoxGeometry(0.06,0.3,0.22),mat.sw);
tab.position.set(-1.42,1.0,0);shoe.add(tab);

shoe.position.y=-0.35;
const pivot=new THREE.Group();pivot.add(shoe);pivot.rotation.z=0.05;
const root=new THREE.Group();root.add(pivot);scene.add(root);

// Soft ground shadow
const cv=document.createElement('canvas');cv.width=cv.height=128;
const cx=cv.getContext('2d'),gr=cx.createRadialGradient(64,64,0,64,64,64);
gr.addColorStop(0,'rgba(0,0,0,.45)');gr.addColorStop(1,'rgba(0,0,0,0)');
cx.fillStyle=gr;cx.fillRect(0,0,128,128);
const shadow=new THREE.Mesh(new THREE.PlaneGeometry(5.2,2.4),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv),transparent:true,depthWrite:false}));
shadow.rotation.x=-Math.PI/2;shadow.position.y=-0.75;scene.add(shadow);

// Colorways
const ways=[
 {n:'White',c:'#f2f2f0',sw:'#f2f2f0',mid:'#ffffff',out:'#e8e8e6',a:'#d9d6cf'},
 {n:'Black',c:'#1a1a1a',sw:'#f2f2f0',mid:'#1a1a1a',out:'#c9a56a',a:'#3a3a3f'},
 {n:'Brown',c:'#6b4423',sw:'#f2f2f0',mid:'#e9dcc6',out:'#c9a56a',a:'#a97142'}
];
const box=document.getElementById('sw');
function setWay(i){
  const w=ways[i];
  mat.upper.color.set(w.c);mat.sw.color.set(w.sw);mat.mid.color.set(w.mid);mat.out.color.set(w.out);
  mat.lace.color.set(i===1?'#f2f2f0':w.c==='#f2f2f0'?'#fafafa':w.sw);
  document.documentElement.style.setProperty('--accent',w.a);
  [...box.querySelectorAll('button')].forEach((b,j)=>b.classList.toggle('on',j===i));
}
ways.forEach((w,i)=>{
  const b=document.createElement('button');b.style.background=w.c;b.title=w.n;b.setAttribute('aria-label',w.n);
  b.onclick=()=>setWay(i);box.appendChild(b);
});
setWay(0);

// Interaction
let rot=-0.6,vel=0,drag=false,lx=0;
const reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
el.addEventListener('pointerdown',e=>{drag=true;lx=e.clientX;el.setPointerCapture(e.pointerId)});
el.addEventListener('pointermove',e=>{if(!drag)return;vel=(e.clientX-lx)*0.012;rot+=vel;lx=e.clientX});
['pointerup','pointercancel'].forEach(ev=>el.addEventListener(ev,()=>{drag=false}));

function fit(){
  const w=el.clientWidth||1,h=el.clientHeight||1;
  renderer.setSize(w,h,false);camera.aspect=w/h;
  camera.position.z=w/h<1?12.5:8.8;camera.updateProjectionMatrix();
}
if(window.ResizeObserver)new ResizeObserver(fit).observe(el);else window.addEventListener('resize',fit);
fit();

const clock=new THREE.Clock();
(function loop(){
  const t=clock.getElapsedTime();
  if(!drag){vel*=0.95;rot+=vel+(reduce?0:0.004);}
  root.rotation.y=rot;
  const f=reduce?0:Math.sin(t*1.4);
  root.position.y=f*0.08;
  shadow.scale.setScalar(1-f*0.04);
  renderer.render(scene,camera);
  requestAnimationFrame(loop);
})();
})();
</script>
</body>
</html>
